# Copia este archivo como ".env" para cambiar los valores por defecto.
# Sin .env, `docker compose up` funciona igual con estos mismos valores.

# --- Puertos en tu PC (cámbialos si ya están ocupados) ----------------
# La aplicación: http://localhost:8080
WEB_PORT=8080
# La API directa, solo para depurar
API_PORT=4000
# PostgreSQL, para DBeaver / pgAdmin / psql
DB_PORT=5433

# --- Base de datos -----------------------------------------------------
POSTGRES_DB=frictionless
POSTGRES_USER=frictionless
POSTGRES_PASSWORD=frictionless

# --- Seguridad ---------------------------------------------------------
# Firma los tokens del personal y los tokens de sesión de mesa.
# En producción usa un valor largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=solo-para-desarrollo-cambia-este-secreto

# --- Restaurante que atienden las rutas públicas (/mesa/12) ------------
DEFAULT_RESTAURANT_SLUG=fogon

# --- Dirección pública -------------------------------------------------
# Con la que clientes y pasarelas llegan a la app, en HTTPS. Necesaria para
# pasarelas reales (Mercado Pago solo acepta regresos HTTPS) y sus webhooks.
# Para probar desde tu PC: un túnel (cloudflared, ngrok) que apunte al 8080.
PUBLIC_BASE_URL=

# --- Mapa ---------------------------------------------------------------
# Por defecto, teselas de OpenStreetMap (gratis, con atribución, para uso
# moderado). Para producción usa un proveedor con clave, p. ej. MapTiler:
#   MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TU_CLAVE
MAP_TILE_URL=
MAP_ATTRIBUTION=

# --- Pagos en línea ----------------------------------------------------
# Cada pasarela funciona en vivo solo si sus credenciales están completas.
# Sin ellas, el cliente pasa por la pasarela de pruebas (no cobra dinero).
# true = usar la pasarela de pruebas aunque haya credenciales.
PAYMENTS_FORCE_TEST=false

# Wompi: panel de comercios > Desarrolladores. Llaves de pruebas: pub_test_…
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos (webhooks). URL a registrar en Wompi:
#   <PUBLIC_BASE_URL>/api/payments/webhooks/wompi
WOMPI_EVENTS_SECRET=

# Mercado Pago: Tus integraciones > Credenciales (Access Token).
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones > Webhooks). La URL se envía sola en cada pago.
MP_WEBHOOK_SECRET=

# Pasarela que procesa PSE: WOMPI o MERCADOPAGO.
PSE_PROVIDER=WOMPI
