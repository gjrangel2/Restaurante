# Copia este archivo como ".env" para cambiar los valores por defecto.
# Sin .env, `docker compose up` funciona igual con estos mismos valores.

# --- Puertos en tu PC (cámbialos si ya están ocupados) ----------------
# La aplicación: http://localhost:8080
WEB_PORT=8080
# La API directa, solo para depurar
API_PORT=4000
# PostgreSQL, para DBeaver / pgAdmin / psql
DB_PORT=5433

# --- Base de datos -----------------------------------------------------
POSTGRES_DB=frictionless
POSTGRES_USER=frictionless
POSTGRES_PASSWORD=frictionless

# --- Seguridad ---------------------------------------------------------
# Firma los tokens del personal y los tokens de sesión de mesa.
# En producción usa un valor largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=solo-para-desarrollo-cambia-este-secreto

# --- Restaurante que atienden las rutas públicas (/mesa/12) ------------
DEFAULT_RESTAURANT_SLUG=fogon
